{
  "name": "careflow-phase3",
  "version": "2.0.0",
  "private": true,
  "description": "Careflow Phase 3 integrated app with normalized relational SQLite persistence",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --experimental-sqlite dist/src/server.js",
    "test": "node --experimental-sqlite --import tsx --test test/*.test.ts",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "db:seed": "tsx src/db/cli.ts seed",
    "db:reset": "tsx src/db/cli.ts reset",
    "db:verify": "tsx src/db/cli.ts verify"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "fflate": "^0.8.3",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.20.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.18.6",
    "@types/pdfkit": "^0.17.6",
    "cross-env": "^10.1.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
